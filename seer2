    if not list then return false end
    
    local target = nil
    for _, item in ipairs(list:GetChildren()) do
        if item:IsA("GuiObject") then
            local txt = ""
            for _, d in ipairs(item:GetDescendants()) do
                if d:IsA("TextLabel") then
                    local t = ""
                    pcall(function() t = d.Text end)

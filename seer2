                cam.CFrame = CFrame.lookAt(
                    robPos + Vector3.new(0, 3.5, 5),
                    robPos + Vector3.new(0, 1.2, 0)
                )
            end
        end)
        task.wait(0.15)
    end
    
    log("🎉 خلصت السرقة")
    return true
end


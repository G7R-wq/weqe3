local function autoLoop()
    if isRunning then return end
    isRunning = true
    stopRequested = false
    
    log("♻️ بدء الدورة")
    setStatus("⏱️ انتظار...", Color3.fromRGB(255, 180, 60))
    
    task.spawn(function()
        while not stopRequested do
            currentLoop = currentLoop + 1
            LoopNum.Text = tostring(currentLoop)
            
            log("")
            log("━━━ الدورة #" .. currentLoop .. " ━━━")
            
            -- 1. انتظار الشخصية
            log("⏳ انتظار التحميل...")
            local waited = 0
            while (not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart")) and not stopRequested do
                task.wait(0.5)
                waited = waited + 0.5
                if waited > 30 then break end
            end
            
            -- 🧊 نجمّد الجسم (يمنع الطيحان)
            freezeCharacter()
            updateFreezeBadge()
            
            -- 2. انتظار 5 ثواني
            log("⏱️ انتظار " .. CONFIG.StartDelay .. " ثواني...")
            setStatus("⏱️ " .. CONFIG.StartDelay .. "s...", Color3.fromRGB(255, 180, 60))
            
            if not countdown(CONFIG.StartDelay, "بدء بعد") then break end
            
            log("✅ جاهز!")
            setStatus("▶️ بدء...", Color3.fromRGB(80, 220, 120))
            
            -- 3. شراء
            if not hasTool() then
                -- نفك التجميد عشان نتحرك للبائع
                unfreezeCharacter()
                updateFreezeBadge()
                buy()
                task.wait(1)
                -- نجمّد بعد الشراء
                freezeCharacter()
                updateFreezeBadge()
            else
                log("✅ عندك الأداة")
            end
            
            -- 4. سرقة
            if hasTool() then
                -- نفك عشان نتحرك
                unfreezeCharacter()
                updateFreezeBadge()
                task.wait(0.2)
                rob()
            else
                log("⚠️ ما عندك الأداة")
            end
            
            -- 5. انتظار قبل الهوب
            log("⏱️ انتظار قبل الهوب...")
            if not countdown(CONFIG.WaitBetweenServers, "هوب بعد") then break end
            
            -- 6. سيرفر هوب
            if not stopRequested then
                hopServer(CONFIG.PreferEmpty)
                task.wait(15)
            end
        end
        
        isRunning = false
        setStatus("⏹️ متوقف", Color3.fromRGB(200, 80, 80))
    end)
end


local function getHRP()
    return LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
end

local function hasTool()
    local keys = {"فاتح", "متقدم", "advanced", "lockpick"}
    local function chk(n)
        local x = n:lower()
        for _, k in ipairs(keys) do 
            if x:find(k:lower()) then return true end 
        end
        return false
    end
    if LP.Character then
        for _, t in ipairs(LP.Character:GetChildren()) do
            if t:IsA("Tool") and chk(t.Name) then return t end
        end
    end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and chk(t.Name) then return t end
        end
    end
    return nil
end

local function clickGui(g)
    if not g then return false end
    local clicked = false
    pcall(function()
        if getconnections then
            for _, c in pairs(getconnections(g.MouseButton1Click)) do
                if c.Function then task.spawn(c.Function); clicked = true end
            end
            for _, c in pairs(getconnections(g.MouseButton1Down)) do
                if c.Function then task.spawn(c.Function); clicked = true end
            end
            for _, c in pairs(getconnections(g.InputBegan)) do
                if c.Function then 
                    task.spawn(c.Function, {UserInputType = Enum.UserInputType.Touch})
                    clicked = true 
                end
            end
            for _, c in pairs(getconnections(g.Activated)) do
                if c.Function then task.spawn(c.Function); clicked = true end
            end
        end
    end)
    pcall(function() g:Activate() end)
    pcall(function()
        local ap = g.AbsolutePosition
        local as = g.AbsoluteSize
        if as.X > 5 and ap.X > 0 then
            local cx = ap.X + as.X/2
            local cy = ap.Y + as.Y/2
            VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
            task.wait(0.03)
            VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
            clicked = true
        end
    end)
    return clicked
end

local function findBtn(root, names)
    if not root then return nil end
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            for _, n in ipairs(names) do
                if obj.Name:lower() == n:lower() then return obj end
            end
        end
    end
    return nil
end

-- ═══ شراء ═══
local function buy()
    log("💰 شراء...")
    setStatus("💰 شراء...", Color3.fromRGB(255, 180, 60))
    
    if hasTool() then log("✅ عندك الأداة"); return true end
    
    local seller = workspace:FindFirstChild("SellerNPC", true)
    if not seller then log("❌ ما فيه بائع"); return false end
    
    local part = seller:IsA("BasePart") and seller or seller:FindFirstChildWhichIsA("BasePart", true)
    if part then
        local hrp = getHRP()
        if hrp then
            hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 3))
        end
        task.wait(0.5)
        -- 🧊 نجمد بعد الانتقال
        freezeCharacter()
        updateFreezeBadge()
    end
    
    local p = seller:FindFirstChildWhichIsA("ProximityPrompt", true)
    if p then
        pcall(function()
            p.HoldDuration = 0
            p.RequiresLineOfSight = false
            p.MaxActivationDistance = 99999
            p.Enabled = true
            fireproximityprompt(p)
        end)
    end
    
    local market, opened = nil, false
    for i = 1, 20 do
        if stopRequested then return false end
        market = PG:FindFirstChild("Market")
        if market then
            local mf = market:FindFirstChild("MainFrame")
            if mf and mf.Visible then opened = true; break end
        end
        task.wait(0.1)
    end
    if not opened then log("❌ Market ما فتح"); return false end
    log("✅ Market فتح")
    task.wait(0.6)
    
    local mf = market:FindFirstChild("MainFrame")
    local list = mf:FindFirstChild("ItemsList")
    if not list then return false end
    
    local target = nil
    for _, item in ipairs(list:GetChildren()) do
        if item:IsA("GuiObject") then
            local txt = ""
            for _, d in ipairs(item:GetDescendants()) do
                if d:IsA("TextLabel") then
                    local t = ""
                    pcall(function() t = d.Text end)
                    if t ~= "" then txt = txt .. " " .. t end
                end
            end
            local low = txt:lower()
            if low:find("lockpick") or low:find("advanced") or low:find("متقدم") or
               (low:find("فاتح") and (low:find("قفل") or low:find("اقفال"))) then
                target = item
                break
            end
        end
    end
    if not target then return false end
    
    local addBtn = nil
    for _, d in ipairs(target:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton")) and 
           (d.Name == "Click" or d.Name == "AddToCart" or d.Name == "Add") then
            addBtn = d; break
        end
    end
    if addBtn then clickGui(addBtn); task.wait(0.7) end
    
    local cart = mf:FindFirstChild("Cart")
    if cart then
        local buyFrame = cart:FindFirstChild("Buy")
        local buyBtn = buyFrame and (findBtn(buyFrame, {"Click","Buy"}) or buyFrame) or findBtn(cart, {"Buy","Click"})
        if buyBtn then clickGui(buyBtn); task.wait(0.7) end
    end
    
    task.wait(0.6)
    if hasTool() then log("🎉 وصلت!"); return true end
    return false
end

-- ═══ سرقة ═══
local function rob()
    log("🏧 سرقة...")
    setStatus("🏧 سرقة...", Color3.fromRGB(255, 80, 120))
    
    local tool = hasTool()
    if tool and LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:EquipTool(tool) end
    end
    task.wait(0.2)
    
    local prompt, robPos = nil, CASHIER_POS
    for _, p in ipairs(workspace:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Name == "StartProximity" then
            prompt = p
            local parent = p.Parent
            local main = parent:FindFirstChild("MainCashier")
            if main and main:IsA("BasePart") then
                robPos = main.Position
            elseif parent:IsA("BasePart") then
                robPos = parent.Position
            end
            break
        end
    end
    if not prompt then log("❌ ما فيه Prompt"); return false end
    
    local hrp = getHRP()
    if hrp then
        hrp.CFrame = CFrame.new(robPos + Vector3.new(0, 2.5, 2))
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    task.wait(0.3)
    
    -- 🧊 نجمد بعد الانتقال للكاشير
    freezeCharacter()
    updateFreezeBadge()
    log("🧊 الجسم مجمد")
    
    pcall(function()
        local cam = workspace.CurrentCamera
        if cam then
            cam.CameraType = Enum.CameraType.Custom
            cam.CFrame = CFrame.lookAt(
                robPos + Vector3.new(0, 3.5, 5),
                robPos + Vector3.new(0, 1.2, 0)
            )
            cam.Focus = CFrame.new(robPos + Vector3.new(0, 1.2, 0))
        end
    end)
    task.wait(0.3)
    
    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 99999
        prompt.Enabled = true
    end)
    
    if not prompt.Enabled then log("⚠️ مقفل"); return false end
    
    local uiBtn = nil
    for i = 1, 20 do
        if stopRequested then return false end
        pcall(function()
            local cam = workspace.CurrentCamera
            if cam then
                cam.CFrame = CFrame.lookAt(
                    robPos + Vector3.new(0, 3.5, 5),
                    robPos + Vector3.new(0, 1.2, 0)
                )
            end
        end)
        
        local pgui = PG:FindFirstChild("ProximityPrompts")
        if pgui then
            for _, obj in ipairs(pgui:GetDescendants()) do
                if (obj:IsA("TextButton") or obj:IsA("ImageButton")) and obj.AbsoluteSize.X > 30 then
                    uiBtn = obj; break
                end
            end
        end
        if uiBtn then break end
        task.wait(0.1)
    end
    
    pcall(function() fireproximityprompt(prompt) end)
    pcall(function()
        VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.05)
        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
    
    if uiBtn then
        local ap = uiBtn.AbsolutePosition
        local as = uiBtn.AbsoluteSize
        local cx = ap.X + as.X/2
        local cy = ap.Y + as.Y/2
        pcall(function()
            VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
            task.wait(0.2)
            VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
        end)
        pcall(function()
            for _, c in pairs(getconnections(uiBtn.InputBegan)) do
                if c.Function then
                    task.spawn(c.Function, {
                        UserInputType = Enum.UserInputType.Touch,
                        UserInputState = Enum.UserInputState.Begin,
                        Position = Vector3.new(cx, cy, 0),
                    })
                end
            end
        end)
        pcall(function() uiBtn:Activate() end)
    end
    
    local startT = tick()
    while tick() - startT < 5 do
        if stopRequested then break end
        pcall(function()
            local cam = workspace.CurrentCamera
            if cam then
                cam.CFrame = CFrame.lookAt(
                    robPos + Vector3.new(0, 3.5, 5),
                    robPos + Vector3.new(0, 1.2, 0)
                )
            end
        end)
        task.wait(0.15)
    end
    
    log("🎉 خلصت السرقة")
    return true
end


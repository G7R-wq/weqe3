local function hopServer()
    log("🌐 ننتقل لسيرفر ثاني...")
    
    -- ✅ نحفظ السكربت عشان يشتغل بعد الانتقال
    local success = false
    pcall(function()
        if queue_on_teleport then
            queue_on_teleport([[
                -- بعد الانتقال، نشغل السكربت من الرابط
                wait(3)
                local url = "]] .. SCRIPT_URL .. [["
                local ok, script = pcall(function()
                    return game:HttpGet(url)
                end)
                if ok and script then
                    loadstring(script)()
                end
            ]])
            success = true
        elseif syn and syn.queue_on_teleport then
            syn.queue_on_teleport([[
                wait(3)
                local url = "]] .. SCRIPT_URL .. [["
                local ok, script = pcall(function()
                    return game:HttpGet(url)
                end)
                if ok and script then
                    loadstring(script)()
                end
            ]])
            success = true
        end
    end)
    
    if success then
        log("✅ حفظنا السكربت للانتقال")
    else
        log("⚠️ queue_on_teleport غير مدعوم")
    end
    
    -- ✅ ننتقل
    task.wait(1)
    pcall(function()
        local TS = game:GetService("TeleportService")
        TS:Teleport(game.PlaceId)
    end)
    
    log("🚀 تم الانتقال")
end


local function rob()
    log("🏧 سرقة...")
    setStatus("🏧 سرقة...", Color3.fromRGB(255, 80, 120))
    
    local tool = hasTool()
    if tool and LP.Character then
        local hum = LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:EquipTool(tool) end
    end
    task.wait(0.2)
    
    local prompt, robPos = nil, CASHIER_POS
    for _, p in ipairs(workspace:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Name == "StartProximity" then
            prompt = p
            local parent = p.Parent
            local main = parent:FindFirstChild("MainCashier")
            if main and main:IsA("BasePart") then
                robPos = main.Position
            elseif parent:IsA("BasePart") then
                robPos = parent.Position
            end
            break
        end
    end
    if not prompt then log("❌ ما فيه Prompt"); return false end
    
    local hrp = getHRP()
    if hrp then
        hrp.CFrame = CFrame.new(robPos + Vector3.new(0, 2.5, 2))
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    task.wait(0.3)
    
    -- 🧊 نجمد بعد الانتقال للكاشير
    freezeCharacter()
    updateFreezeBadge()
    log("🧊 الجسم مجمد")
    
    pcall(function()
        local cam = workspace.CurrentCamera
        if cam then
            cam.CameraType = Enum.CameraType.Custom
            cam.CFrame = CFrame.lookAt(
                robPos + Vector3.new(0, 3.5, 5),
                robPos + Vector3.new(0, 1.2, 0)
            )
            cam.Focus = CFrame.new(robPos + Vector3.new(0, 1.2, 0))
        end
    end)
    task.wait(0.3)
    
    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 99999
        prompt.Enabled = true
    end)
    
    if not prompt.Enabled then log("⚠️ مقفل"); return false end
    
    local uiBtn = nil
    for i = 1, 20 do
        if stopRequested then return false end
        pcall(function()
            local cam = workspace.CurrentCamera
            if cam then
                cam.CFrame = CFrame.lookAt(
                    robPos + Vector3.new(0, 3.5, 5),
                    robPos + Vector3.new(0, 1.2, 0)
                )
            end
        end)
        
        local pgui = PG:FindFirstChild("ProximityPrompts")
        if pgui then
            for _, obj in ipairs(pgui:GetDescendants()) do
                if (obj:IsA("TextButton") or obj:IsA("ImageButton")) and obj.AbsoluteSize.X > 30 then
                    uiBtn = obj; break
                end
            end
        end
        if uiBtn then break end
        task.wait(0.1)
    end
    
    pcall(function() fireproximityprompt(prompt) end)
    pcall(function()
        VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.05)
        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
    
    if uiBtn then
        local ap = uiBtn.AbsolutePosition
        local as = uiBtn.AbsoluteSize
        local cx = ap.X + as.X/2
        local cy = ap.Y + as.Y/2
        pcall(function()
            VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
            task.wait(0.2)
            VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
        end)
        pcall(function()
            for _, c in pairs(getconnections(uiBtn.InputBegan)) do
                if c.Function then
                    task.spawn(c.Function, {
                        UserInputType = Enum.UserInputType.Touch,
                        UserInputState = Enum.UserInputState.Begin,
                        Position = Vector3.new(cx, cy, 0),

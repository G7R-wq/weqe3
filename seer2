local function hopServer(preferEmpty)
    log("🌐 نبحث عن سيرفر فاضي...")
    setStatus("🌐 Server Hop...", Color3.fromRGB(150, 200, 255))
    
    -- 🧊 نفك التجميد قبل الهوب (مهم!)
    unfreezeCharacter()
    updateFreezeBadge()
    
    -- نحفظ السكربت
    local queueCode = string.format([[
        wait(5)
        local url = "%s"
        local ok, s = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and s then
            loadstring(s)()
        end
    ]], SCRIPT_URL)
    
    local saved = false
    pcall(function()
        if queue_on_teleport then queue_on_teleport(queueCode); saved = true end
    end)
    if not saved then
        pcall(function()
            if syn and syn.queue_on_teleport then syn.queue_on_teleport(queueCode); saved = true end
        end)
    end
    if not saved then
        pcall(function()
            if fluxus and fluxus.queue_on_teleport then fluxus.queue_on_teleport(queueCode); saved = true end
        end)
    end
    
    task.wait(1)
    
    local servers = {}
    pcall(function()
        servers = TS:GetPublicServersAsync(game.PlaceId)
    end)
    
    if #servers == 0 then
        log("⚠️ Teleport عادي")
        pcall(function() TS:Teleport(game.PlaceId) end)
        return
    end
    
    local currentJob = game.JobId
    local emptyServers, lowServers, anyServers = {}, {}, {}
    
    for _, s in ipairs(servers) do
        if s.id ~= currentJob and s.playing < s.maxPlayers then
            table.insert(anyServers, s)
            if s.playing == 0 then
                table.insert(emptyServers, s)
            elseif s.playing <= CONFIG.MaxPlayersInServer then
                table.insert(lowServers, s)
            end
        end
    end
    
    log("🟢 فاضية: " .. #emptyServers .. " | 🟡 قليل: " .. #lowServers)
    
    local pick = nil
    if preferEmpty and #emptyServers > 0 then
        pick = emptyServers[math.random(1, #emptyServers)]
        log("✅ اخترنا سيرفر فاضي!")
    elseif #lowServers > 0 then
        pick = lowServers[math.random(1, #lowServers)]
        log("✅ سيرفر بشوية لاعبين")
    elseif #anyServers > 0 then
        table.sort(anyServers, function(a, b) return a.playing < b.playing end)
        pick = anyServers[1]
    end
    
    if pick then
        log("🎯 " .. pick.id:sub(1, 8) .. " (" .. pick.playing .. "/" .. pick.maxPlayers .. ")")
        pcall(function()
            TS:TeleportToPlaceInstance(game.PlaceId, pick.id)
        end)
    else
        pcall(function() TS:Teleport(game.PlaceId) end)
    end
end


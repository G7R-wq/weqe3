local function freezeCharacter()
    if not CONFIG.FreezeCharacter then return end
    
    local char = LP.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if CONFIG.FreezeMode == "Anchor" and hrp then
        -- ✅ نثبت الجسم (يمنع الطيحان)
        hrp.Anchored = true
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        isFrozen = true
    elseif CONFIG.FreezeMode == "WalkSpeed" and hum then
        -- ✅ نوقف الحركة بس (يمشي لكن ما يطيح)
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        isFrozen = true
    end
end

local function unfreezeCharacter()
    if not isFrozen then return end
    
    local char = LP.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if hrp then
        pcall(function() hrp.Anchored = false end)
    end
    if hum then
        pcall(function()
            hum.WalkSpeed = 16
            hum.JumpPower = 50
        end)
    end
    isFrozen = false
end


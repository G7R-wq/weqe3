local function countdown(seconds, message)
    message = message or "بدء بعد"
    for i = seconds, 1, -1 do
        if stopRequested then return false end
        CountText.Text = message .. ": " .. i .. "s"
        task.wait(1)
    end
    CountText.Text = message .. ": --"
    return true
end


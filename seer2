local function getHRP()
    return LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
end

local function hasTool()
    local keys = {"فاتح", "متقدم", "advanced", "lockpick"}
    local function chk(n)
        local x = n:lower()
        for _, k in ipairs(keys) do 
            if x:find(k:lower()) then return true end 
        end
        return false
    end
    if LP.Character then
        for _, t in ipairs(LP.Character:GetChildren()) do
            if t:IsA("Tool") and chk(t.Name) then return t end
        end
    end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and chk(t.Name) then return t end
        end
    end
    return nil
end

local function clickGui(g)
    if not g then return false end
    local clicked = false
    pcall(function()
        if getconnections then
            for _, c in pairs(getconnections(g.MouseButton1Click)) do
                if c.Function then task.spawn(c.Function); clicked = true end
            end
            for _, c in pairs(getconnections(g.MouseButton1Down)) do
                if c.Function then task.spawn(c.Function); clicked = true end
            end
            for _, c in pairs(getconnections(g.InputBegan)) do
                if c.Function then 
                    task.spawn(c.Function, {UserInputType = Enum.UserInputType.Touch})
                    clicked = true 
                end
            end
            for _, c in pairs(getconnections(g.Activated)) do
                if c.Function then task.spawn(c.Function); clicked = true end
            end
        end
    end)
    pcall(function() g:Activate() end)
    pcall(function()
        local ap = g.AbsolutePosition
        local as = g.AbsoluteSize
        if as.X > 5 and ap.X > 0 then
            local cx = ap.X + as.X/2
            local cy = ap.Y + as.Y/2
            VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
            task.wait(0.03)
            VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
            clicked = true
        end
    end)
    return clicked
end

local function findBtn(root, names)
    if not root then return nil end
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            for _, n in ipairs(names) do
                if obj.Name:lower() == n:lower() then return obj end
            end
        end
    end
    return nil
end


local function teleport(targetPos)
    local root = getRoot()
    if not root or not targetPos then return false end
    if (root.Position - targetPos).Magnitude < CFG.OK_DIST then return true end
    for _=1,5 do
        if not getRoot() then return false end
        pcall(function() root.CFrame = CFrame.new(targetPos + Vector3.new(0, CFG.Offset_Y, 0)); root.AssemblyLinearVelocity = Vector3.zero end)
        task.wait(0.03)
    end
    task.wait(0.05)
    local cur = getRoot()
    return cur and (cur.Position - targetPos).Magnitude < CFG.OK_DIST
end


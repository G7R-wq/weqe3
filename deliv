local STORE_MAP = {
    ["الفيك"]="Al-Fake", ["فيك"]="Al-Fake",
    ["الصيدلية"]="Pharmacy", ["صيدلية"]="Pharmacy", ["pharmacy"]="Pharmacy",
    ["قهوة امجي"]="MJCoffee", ["قهوه امجي"]="MJCoffee", ["mjcoffee"]="MJCoffee",
    ["الزينة"]="AccessoriesShop", ["زينة"]="AccessoriesShop",
    ["ابو شمعة"]="AboSham3a", ["ابو شمعه"]="AboSham3a",
    ["هارفن"]="harven", ["السوبرماركت"]="Supermarket", ["سوبرماركت"]="Supermarket",
    ["لوحات"]="PlateShop", ["لوحة"]="PlateShop", ["متجر لوحات"]="PlateShop",
    ["ربع"]="Quarter", ["الفاين"]="Fine", ["فاين"]="Fine",
    ["رودو"]="RUDU", ["rudu"]="RUDU",
}
local GENERIC_WORDS = { "متجر", "محل", "store", "shop", "ال", "the" }

local function getRoot()
    local char = player.Character
    if not char then return nil end
    local r = char:FindFirstChild("HumanoidRootPart")
    local h = char:FindFirstChildOfClass("Humanoid")
    return (r and h and h.Health > 0) and r or nil
end

local function clean(s)
    if not s then return "" end
    return tostring(s):lower():gsub("[%p%c]", " "):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
end

local function normalizeArabic(s)
    if not s then return "" end
    s = tostring(s):lower():gsub("[أإآ]", "ا"):gsub("ة", "ه"):gsub("ى", "ي"):gsub("[ؤئ]", "ي"):gsub("%s+", ""):gsub("^ال", "")
    return s
end

local function mapStore(name)
    local n = normalizeArabic(name)
    if STORE_MAP[name] then return STORE_MAP[name] end
    if STORE_MAP[n] then return STORE_MAP[n] end
    for k, v in pairs(STORE_MAP) do if normalizeArabic(k) == n then return v end end
    return nil
end

local function extractMeaningfulWords(text)
    local words = {}
    for word in string.gmatch(clean(text), "%S+") do
        local w = word:gsub("^ال", "")
        local isGen = false
        for _, g in ipairs(GENERIC_WORDS) do if w == g or word == g then isGen = true break end end
        if not isGen and #w >= 3 then table.insert(words, w) end
    end
    return words
end

local function extractPrice(text)
    if not text then return nil end
    local s = tostring(text):gsub(",", ""):gsub("%$", "")
    local scope = s:find("سعر التوصيل", 1, true) and s:sub(s:find("سعر التوصيل", 1, true)) or s
    local nums = {}
    for n in scope:gmatch("%d+") do table.insert(nums, tonumber(n)) end
    if #nums == 0 then for n in s:gmatch("%d+") do table.insert(nums, tonumber(n)) end end
    return nums[#nums]
end


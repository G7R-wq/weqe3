    task.wait(0.1)
    
    if not autoRunning then return false end
    if not hasMjDeliveryGui() then return true end
    if not ok then return false end
    if not (botInfo.prompt and botInfo.prompt.Parent) then return false end

    if not isCarryingPackage() then
        stepLbl.Text = "⚠️ الطرد مو بيدك! تخطي"
        return false 
    end

    stepLbl.Text = "⚡ بوت " .. num .. ": ضغطة"
    botLbl.Text = "🤖 بوت " .. num .. " (" .. math.floor(botInfo.dist) .. "m)"
    
    firePrompt(botInfo.prompt)
    task.wait(CFG.BOT_CHECK_WAIT)
    
    if not hasMjDeliveryGui() or not isCarryingPackage() then
        botLbl.Text = "🤖 بوت " .. num .. " ✅"
        return true
    end

    botLbl.Text = "🤖 بوت " .. num .. " ❌ التالي"
    return false
end

-------------------------------------------------
-- 📦 Order Processing
-------------------------------------------------
local function processOrder(content, currentPrice)
    if currentProcessingContent == content then stepLbl.Text="⚠️ نفس الطلب - تخطي"; return false end
    if isProcessing then stepLbl.Text="⏳ شغال..."; return false end
    
    currentProcessingContent = content
    isProcessing = true
    
    local data = readMjDeliveryWithRetries()
    if not data then stepLbl.Text="⚠️ فشل قراءة"; isProcessing=false; currentProcessingContent=nil; return false end
    
    CACHE.storeLine=data.storeLine; CACHE.storeNames=data.storeNames; CACHE.priceLine=data.priceLine
    storeLbl.Text = "🏪 " .. tostring(CACHE.storeLine or "-")
    if currentPrice then priceLbl.Text="💰 الفلوس: "..currentPrice; priceLbl.TextColor3=Color3.fromRGB(100,255,150) end
    
    stepLbl.Text = "⏳ تحضير..."
    task.wait(CFG.NEW_ORDER_WAIT)
    if not autoRunning then isProcessing=false; currentProcessingContent=nil; return false end
    
    stepLbl.Text = "📍 بحث عن متجر..."
    local storeP, storePos
    local t0 = tick()
    while tick()-t0 < CFG.STORE_TIMEOUT and autoRunning do
        storeP, storePos = findStorePrompt(CACHE.storeNames)
        if storePos then break end
        task.wait(0.2)
    end
    
    if not storePos or not autoRunning then stepLbl.Text="⚠️ ما فيه متجر"; isProcessing=false; currentProcessingContent=nil; return false end
    
    stepLbl.Text = "📍 انتقال للمتجر"
    if not teleport(storePos) or not autoRunning then isProcessing=false; currentProcessingContent=nil; return false end
    task.wait(0.1)
    
    stepLbl.Text = "📦 فحص الطرد..."
    local hasPackage = isCarryingPackage()
    
    if not hasPackage then
        stepLbl.Text = "🔄 جاري الاستلام..."
        for attempt = 1, CFG.RE_PICKUP_ATTEMPTS do
            if not autoRunning then break end
            if storeP and storeP.Parent then
                firePrompt(storeP)
            else
                local p2 = findStorePrompt(CACHE.storeNames)
                if p2 then storeP = p2; firePrompt(p2) end
            end
            task.wait(CFG.RE_PICKUP_WAIT)
            if isCarryingPackage() then
                stepLbl.Text = "✅ تم الاستلام!"
                hasPackage = true
                break
            end
        end
    else
        stepLbl.Text = "✅ الطرد موجود"
    end
    
    if not hasPackage then
        stepLbl.Text = "❌ فشل الاستلام"
        isProcessing = false
        currentProcessingContent = nil
        return false
    end
    
    task.wait(0.2)
    stepLbl.Text = "📍 بحث عن بوتات..."
    local bots = {}
    t0 = tick()
    while tick()-t0 < CFG.BOT_TIMEOUT and autoRunning do
        bots = getAllBots()
        if #bots > 0 then break end
        task.wait(0.2)
    end
    
    if #bots == 0 or not autoRunning then stepLbl.Text="⚠️ ما فيه بوت"; isProcessing=false; currentProcessingContent=nil; return false end
    botLbl.Text = "🤖 " .. #bots .. " بوت"
    
    local delivered = false
    for i = 1, math.min(#bots, CFG.MAX_BOT_TRIES) do
        if not autoRunning then break end
        if not hasMjDeliveryGui() then delivered=true; break end
        
        local success = tryDeliverToBot(bots[i], i)
        if success then delivered=true; break end
        stepLbl.Text = "⚡ بوت " .. i .. " → التالي"
    end
    
    isProcessing = false
    currentProcessingContent = nil
    
    if delivered then
        completed = completed + 1
        countLbl.Text = "🎯 المهام: " .. completed
        return true
    else
        stepLbl.Text = "⚠️ فشل التسليم"
        return false
    end
end

-------------------------------------------------
-- 🔄 Main Loop
-------------------------------------------------
local function deliveryLoop()
    stepLbl.Text = "⏳ بدء..."
    for i = CFG.START_DELAY, 1, -1 do
        if not autoRunning then return end
        stepLbl.Text = "⏳ " .. i .. "..."
        task.wait(1)
    end
    
    resetAll(); cooldown=0; mjWasVisible=false
    
    while autoRunning do
        if RESPAWN_FLAG then RESPAWN_FLAG=false; resetAll(); mjWasVisible=false; stepLbl.Text="💀 ريسباون..."; task.wait(1.5) end
        
        local hasMj = hasMjDeliveryGui()
        
        if not hasMj then
            mjWasVisible = false
            stepLbl.Text = "💤 بانتظار طلب..."
            cacheLbl.Text = "💾 " .. countDelivered() .. " مسلّم"
            priceLbl.TextColor3 = Color3.fromRGB(100, 255, 150)
            task.wait(CFG.IDLE_CHECK_INTERVAL)
        else
            mjWasVisible = true
            local data = readMjDeliveryWithRetries()
            if not data then 
                stepLbl.Text = "⏳ قراءة..."
                task.wait(0.3)
            else
                local content = (data.storeLine or "") .. "|" .. (data.priceLine or "")
                local currentPrice = extractPrice(data.priceLine)
                
                if currentPrice then priceLbl.Text="💰 "..currentPrice; priceLbl.TextColor3=Color3.fromRGB(100,255,150) end
                cleanHistory()
                
                local timeSinceLast = tick() - lastDeliveryTime
                
                if CFG.REQUIRE_PRICE and not currentPrice then
                    stepLbl.Text="⚠️ لا يوجد سعر"; cooldown=tick()+1
                elseif currentPrice and isPriceBlocked(currentPrice) then
                    local rem = getPriceKeep() == math.huge and "∞" or math.floor(getPriceKeep()-(tick()-deliveredPrices[currentPrice])).."ث"
                    stepLbl.Text="⏭️ نفس السعر - تخطي "..rem
                    priceLbl.Text="💰 "..currentPrice.." ⛔"; priceLbl.TextColor3=Color3.fromRGB(255,100,100)
                    cooldown=tick()+1
                elseif isRecentlyDelivered(content) then
                    stepLbl.Text="✅ مسلّم حديثاً"
                    cacheLbl.Text="💾 مسلّم"; cooldown=tick()+0.5
                elseif timeSinceLast < CFG.POST_DELIVERY_COOLDOWN then
                    stepLbl.Text="⏳ تهدئة.."
                elseif tick() < cooldown then
                    stepLbl.Text="⏳ انتظار.."
                else
                    stepLbl.Text = currentPrice and "🆕 "..currentPrice or "🆕 طلب جديد"
                    cacheLbl.Text = "🆕 تنفيذ"
                    
                    local ok = processOrder(content, currentPrice)
                    if ok then
                        if not hasMjDeliveryGui() then
                            addDelivered(content, currentPrice)
                            cacheLbl.Text="💾 "..countDelivered().." مسلّم"
                            stepLbl.Text="🎉 تم!"
                            botLbl.Text="🤖 جاهز"
                            cooldown = tick() + CFG.POST_DELIVERY_COOLDOWN
                        else
                            stepLbl.Text="⚠️ الطلب باقي"; cooldown=tick()+2
                        end
                    else
                        cooldown=tick()+2; stepLbl.Text="⚠️ فشل"
                    end
                end
            end
        end
        task.wait(CFG.CHECK_INTERVAL)
    end
end


local function tryReadOnce()
    local newStoreLine, newPriceLine = nil, nil
    pcall(function()
        for _, sg in ipairs(playerGui:GetChildren()) do
            if sg:IsA("ScreenGui") and sg.Enabled then
                local hasTitle = false
                for _, lbl in ipairs(sg:GetDescendants()) do
                    if (lbl:IsA("TextLabel") or lbl:IsA("TextButton")) and lbl.Visible and string.find(lbl.Text or "", "Mj Studios Delivery", 1, true) then
                        hasTitle = true; break
                    end
                end
                if hasTitle then
                    for _, lbl in ipairs(sg:GetDescendants()) do
                        if (lbl:IsA("TextLabel") or lbl:IsA("TextButton")) and lbl.Visible then
                            local t = lbl.Text or ""
                            if #t > 1 and not string.find(t, "Mj Studios Delivery", 1, true) then
                                if string.find(t, "|", 1, true) and not newStoreLine then newStoreLine = t end
                                if (string.find(t, "سعر التوصيل", 1, true) or string.find(t, "السعر", 1, true)) and not newPriceLine then newPriceLine = t end
                            end
                        end
                    end
                end
            end
        end
    end)
    if newStoreLine then
        local names = {}
        for part in string.gmatch(newStoreLine, "[^|]+") do
            local c = clean(part)
            if #c >= 2 then table.insert(names, c); local w=c:gsub("^ال",""); if #w>=2 and w~=c then table.insert(names,w) end end
        end
        return {storeLine=newStoreLine, storeNames=names, priceLine=newPriceLine}
    end
    return nil
end


local function clickWithCamera(btn)
    if not btn or not btn.Parent or not btn.Visible then return false end
    local ap, as = btn.AbsolutePosition, btn.AbsoluteSize
    if as.X<=0 or as.Y<=0 then return false end
    local inset = GuiService:GetGuiInset()
    local pos = {x=ap.X+as.X/2, y=ap.Y+as.Y/2+inset.Y}
    pcall(function() VirtualInputManager:SendMouseMoveEvent(pos.x, pos.y, game) end)
    task.wait(0.15)
    pcall(function()
        local cam = workspace.CurrentCamera
        if cam then
            local ray = cam:ViewportPointToRay(pos.x, pos.y)
            local newLook = CFrame.lookAt(cam.CFrame.Position, ray.Origin + ray.Direction * 100)
            cam.CFrame = cam.CFrame:Lerp(newLook, 0.5)
        end
    end)
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(pos.x, pos.y, 0, true, game, 1)
        task.wait(0.03)
        VirtualInputManager:SendMouseButtonEvent(pos.x, pos.y, 0, false, game, 1)
    end)
    pcall(function() if firesignal then firesignal(btn.MouseButton1Click) end; btn.MouseButton1Click:Fire() end)
    return true
end


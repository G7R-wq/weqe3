local function findStorePrompt(storeNames)
    if not storeNames or #storeNames == 0 then return nil, nil end
    local ds = workspace:FindFirstChild("DeliverySystem")
    local tp = ds and ds:FindFirstChild("TakePrompts")
    if not tp then return nil, nil end
    
    local searchWords, seen = {}, {}
    for _, name in ipairs(storeNames) do
        local mapped = mapStore(name)
        if mapped then local k=normalizeArabic(mapped); if not seen[k] then table.insert(searchWords,{word=k,priority=3}); seen[k]=true end end
        for _, w in ipairs(extractMeaningfulWords(name)) do local nw=normalizeArabic(w); if #nw>=3 and not seen[nw] then table.insert(searchWords,{word=nw,priority=2}); seen[nw]=true end end
        local n = normalizeArabic(name); if #n>=3 and not seen[n] then table.insert(searchWords,{word=n,priority=1}); seen[n]=true end
    end
    
    local bestP, bestPos, bestScore = nil, nil, -1
    for _, storeModel in ipairs(tp:GetChildren()) do
        local smNorm = normalizeArabic(storeModel.Name or "")
        local score = 0
        for _, kw in ipairs(searchWords) do
            if smNorm == kw.word then score = math.max(score, 1000*kw.priority)
            elseif string.find(smNorm, kw.word, 1, true) then score = math.max(score, 200*kw.priority)
            elseif string.find(kw.word, smNorm, 1, true) and #smNorm>=3 then score = math.max(score, 100*kw.priority) end
        end
        if score > 0 then
            for _, p in ipairs(storeModel:GetDescendants()) do
                if p:IsA("ProximityPrompt") and p.Enabled then
                    local pos = (p.Parent:IsA("BasePart") and p.Parent.Position) or (p.Parent:IsA("Model") and p.Parent:GetPivot().Position)
                    if pos and score > bestScore then
                        local act, obj = clean(p.ActionText or ""), clean(p.ObjectText or "")
                        if string.find(act.." "..obj, "استلام", 1, true) then bestP, bestPos, bestScore = p, pos, score end
                    end
                end
            end
        end
    end
    return bestP, bestPos
end

local function getAllBots()
    if cachedBots and (tick() - cachedBotsTime < 0.8) then return cachedBots end
    local list = {}
    local npcs = workspace:FindFirstChild("NPCS")
    if not npcs then return list end
    local root = getRoot()
    local myPos = root and root.Position or Vector3.zero
    for _, npc in ipairs(npcs:GetChildren()) do
        if npc ~= player.Character and string.match(npc.Name or "", "^{[%x%-]+}$") then
            for _, desc in ipairs(npc:GetDescendants()) do
                if desc:IsA("ProximityPrompt") and desc.Enabled then
                    local act, obj = clean(desc.ActionText or ""), clean(desc.ObjectText or "")
                    if string.find(desc.Name, "DeliveryOrder", 1, true) or string.find(act.." "..obj, "تسليم الطلبية", 1, true) then
                        local pos = (desc.Parent:IsA("BasePart") and desc.Parent.Position) or (desc.Parent:IsA("Attachment") and desc.Parent.WorldPosition) or (desc.Parent:IsA("Model") and desc.Parent:GetPivot().Position)
                        if pos then table.insert(list, {prompt=desc, pos=pos, dist=(pos-myPos).Magnitude}) end
                    end
                end
            end
        end
    end
    table.sort(list, function(a,b) return a.dist < b.dist end)
    cachedBots, cachedBotsTime = list, tick()
    return list
end

